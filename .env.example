# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Where services read data from. "static" = seed files in src/data. "api" = future backend.
NEXT_PUBLIC_DATA_SOURCE=static
# Shows demo-only affordances (Mirror Try event inspector, demo banner).
NEXT_PUBLIC_DEMO_MODE=true
